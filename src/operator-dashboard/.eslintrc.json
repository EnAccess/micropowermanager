{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:vue/essential",
    "prettier",
    "plugin:import/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "plugins": [
    "vue"
  ],
  "rules": {
    "vue/multi-word-component-names": 0,
    "vue/no-v-text-v-html-on-component": 0,
    "vue/block-lang": [
      "error",
      {
        "style": {
          "lang": "scss"
        }
      }
    ],
    "vue/enforce-style-attribute": [
      "error",
      {
        "allow": [
          "scoped"
        ]
      }
    ],
    "import/extensions": [
      "error",
      "ignorePackages"
    ],
    "import/order": [
      "error",
      {
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        },
        "named": true,
        "newlines-between": "always",
        "warnOnUnassignedImports": true
      }
    ]
  },
  "settings": {
    "import/extensions": [
      ".js",
      ".vue"
    ],
    "import/resolver": {
      "node": {
        "extensions": [
          ".js",
          ".vue"
        ]
      },
      "webpack": {
        "config": "./node_modules/@vue/cli-service/webpack.config.js"
      }
    }
  }
}
