meta {
  name: Change Agent Password
  type: http
  seq: 1
}

put {
  url: {{mpm_backend_url}}/api/agents/1/password
  body: json
  auth: inherit
}

body:json {
  {
    "password": "123123",
    "password_confirmation": "123123"
  }
}

assert {
  res.status: eq 200
  res.body.data.message: eq Password updated successfully
}

docs {
  Admin panel endpoint: sets the password of an existing agent directly.
  Requires an admin bearer token from `Login (Admin)`.
}
