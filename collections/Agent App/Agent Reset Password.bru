meta {
  name: Agent Reset Password
  type: http
  seq: 16
}

post {
  url: {{mpm_backend_url}}/api/app/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com"
  }
}

assert {
  res.status: eq 200
  res.body.data.status_code: eq 200
  res.body.data.message: eq If the email exists, a new password has been sent to it.
}

docs {
  Unauthenticated. Answers with the same generic message whether or not the
  email belongs to an agent, so the endpoint cannot be used to enumerate agents.
}
